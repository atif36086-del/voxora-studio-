# Google Gemini API Key(s)
# Multi-key pool supported: Add multiple keys as GOOGLE_API_KEY_2, GOOGLE_API_KEY_3, etc.
GOOGLE_API_KEY=your_first_google_api_key_here
GOOGLE_API_KEY_2=your_second_google_api_key_here
GOOGLE_API_KEY_3=your_third_google_api_key_here

# Security PIN for private access
APP_PIN=8369
